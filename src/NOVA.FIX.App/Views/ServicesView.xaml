<UserControl x:Class="NOVA.FIX.App.Views.ServicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:NOVA.FIX.App.Views">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Border Grid.Row="0" Style="{StaticResource Card}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button Style="{StaticResource PrimaryButton}" Content="Refresh" Command="{Binding RefreshCommand}" Margin="0,0,8,0"/>
          <Button Style="{StaticResource GhostButton}" Content="Snapshot" Command="{Binding SnapshotCommand}" Margin="0,0,8,0"/>
          <Button Style="{StaticResource GhostButton}" Content="Set Manual"
                  Command="{Binding SetManualCommand}"
                  Foreground="{DynamicResource WarningBrush}"/>
        </StackPanel>
        <StackPanel>
          <TextBlock Text="Service Manager — critical services are never modified" Style="{StaticResource H2}"/>
          <TextBox Width="260" HorizontalAlignment="Left" Margin="0,6,0,0"
                   Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}"
                   ToolTip="Filter by name"/>
        </StackPanel>
      </DockPanel>
    </Border>
    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,12,0,0">
      <DataGrid ItemsSource="{Binding Services}" SelectedItem="{Binding Selected}"
                AutoGenerateColumns="False" IsReadOnly="True"
                Background="Transparent" BorderThickness="0"
                HeadersVisibility="Column" RowBackground="Transparent"
                AlternatingRowBackground="{DynamicResource ElevatedBrush}">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Service" Binding="{Binding ServiceName}" Width="150"/>
          <DataGridTextColumn Header="Display name" Binding="{Binding DisplayName}" Width="200"/>
          <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90"/>
          <DataGridTextColumn Header="Start type" Binding="{Binding StartType}" Width="100"/>
          <DataGridTextColumn Header="Dependencies" Binding="{Binding DependenciesString}" Width="*"/>
        </DataGrid.Columns>
      </DataGrid>
    </Border>
    <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,12,0,0">
      <StackPanel>
        <TextBlock Text="{Binding Selected.DisplayName}" Style="{StaticResource H2}"/>
        <TextBlock Text="{Binding Selected.Description}" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
        <TextBlock Text="{Binding Selected.ExecutablePath}" Style="{StaticResource Muted}" FontFamily="Consolas"/>
        <TextBlock Text="Selected service is CRITICAL — modification denied by design."
                   Foreground="{DynamicResource DangerBrush}" Margin="0,6,0,0"
                   Visibility="{Binding IsCriticalSelected, Converter={x:Static views:UiConverters.BoolToVisibility}}"/>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
