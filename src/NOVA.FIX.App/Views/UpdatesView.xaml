<UserControl x:Class="NOVA.FIX.App.Views.UpdatesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Border Grid.Row="0" Style="{StaticResource Card}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button Style="{StaticResource PrimaryButton}" Content="Import package(s)…" Command="{Binding BrowseCommand}" Margin="0,0,8,0"/>
          <Button Style="{StaticResource GhostButton}" Content="Install selected" Command="{Binding InstallCommand}" Margin="0,0,8,0"/>
          <Button Style="{StaticResource GhostButton}" Content="History" Command="{Binding HistoryCommand}"/>
        </StackPanel>
        <StackPanel>
          <TextBlock Text="Offline Update Manager — USB / local folder packages" Style="{StaticResource H2}"/>
          <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
        </StackPanel>
      </DockPanel>
    </Border>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,12,6,0">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="Imported packages (inspected, not executed)" Style="{StaticResource H2}" Margin="0,0,0,8"/>
          <ListBox ItemsSource="{Binding Imported}" SelectedItem="{Binding Selected}"
                   BorderThickness="0" Background="Transparent">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="0,4">
                  <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                  <TextBlock Style="{StaticResource Muted}">
                    <Run Text="{Binding PackageKind, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding SignatureStatus, Mode=OneWay}"/>
                  </TextBlock>
                  <TextBlock Text="{Binding CompatibilityStatus}" Style="{StaticResource Muted}"/>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>
      <Border Grid.Column="1" Style="{StaticResource Card}" Margin="6,12,0,0">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="Installation history" Style="{StaticResource H2}" Margin="0,0,0,8"/>
          <ListBox ItemsSource="{Binding History}" BorderThickness="0" Background="Transparent">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="0,4">
                  <TextBlock Text="{Binding FileName}" FontWeight="SemiBold"/>
                  <TextBlock Style="{StaticResource Muted}">
                    <Run Text="{Binding Result, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Detail, Mode=OneWay}"/>
                  </TextBlock>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
