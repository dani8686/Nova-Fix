<UserControl x:Class="NOVA.FIX.App.Views.CompatibilityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
    <Border Style="{StaticResource Card}">
      <DockPanel>
        <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}"
                Content="Analyze (offline)" Command="{Binding AnalyzeCommand}"/>
        <StackPanel>
          <TextBlock Text="Windows Compatibility Center" Style="{StaticResource H2}"/>
          <TextBlock Text="{Binding DatabaseInfo}" Style="{StaticResource Muted}" Margin="0,4,0,0"
                     Foreground="{DynamicResource WarningBrush}"/>
        </StackPanel>
      </DockPanel>
    </Border>
    <Border Style="{StaticResource Card}">
      <ItemsControl ItemsSource="{Binding Findings}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding}" Style="{StaticResource Muted}" Margin="0,4" TextWrapping="Wrap"/>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Border>
    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Muted}"/>
  </StackPanel>
</UserControl>
