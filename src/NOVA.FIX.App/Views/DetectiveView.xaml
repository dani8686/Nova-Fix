<UserControl x:Class="NOVA.FIX.App.Views.DetectiveView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Border Grid.Row="0" Style="{StaticResource Card}">
      <DockPanel>
        <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}"
                Content="Collect evidence &amp; correlate" Command="{Binding LoadEvidenceCommand}"/>
        <TextBlock Text="Evidence-driven correlation — system evidence, rule-based inference and AI interpretation are always labelled distinctly."
                   Style="{StaticResource Muted}" VerticalAlignment="Center"/>
      </DockPanel>
    </Border>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,12,6,0">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="Findings" Style="{StaticResource H2}" Margin="0,0,0,8"/>
          <ListBox ItemsSource="{Binding Findings}" SelectedItem="{Binding Selected}"
                   BorderThickness="0" Background="Transparent">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="0,4">
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                  <TextBlock Style="{StaticResource Muted}">
                    <Run Text="{Binding Severity, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Confidence, Mode=OneWay}"/>
                  </TextBlock>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>
      <Grid Grid.Column="1" Margin="6,12,0,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="2*"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Style="{StaticResource Card}">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel DataContext="{Binding Selected}">
              <TextBlock Text="{Binding Title}" Style="{StaticResource H2}"/>
              <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" Margin="0,8,0,0"/>
              <TextBlock Text="Possible causes" Style="{StaticResource H2}" Margin="0,12,0,4"/>
              <ItemsControl ItemsSource="{Binding PossibleCauses}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource Muted}"/></DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="Recommended solution" Style="{StaticResource H2}" Margin="0,12,0,4"/>
              <TextBlock Text="{Binding RecommendedSolution}" Style="{StaticResource Muted}"/>
              <TextBlock Text="Risks" Style="{StaticResource H2}" Margin="0,12,0,4"/>
              <TextBlock Text="{Binding Risks}" Style="{StaticResource Muted}"/>
              <TextBlock Text="Verification" Style="{StaticResource H2}" Margin="0,12,0,4"/>
              <TextBlock Text="{Binding VerificationMethod}" Style="{StaticResource Muted}"/>
              <TextBlock Text="{Binding UncertaintyExplanation}" Style="{StaticResource Muted}"
                         Margin="0,12,0,0" Foreground="{DynamicResource WarningBrush}"/>
            </StackPanel>
          </ScrollViewer>
        </Border>
        <Border Grid.Row="1" Style="{StaticResource Card}">
          <DockPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}"
                    Content="Ask (offline RAG)" Command="{Binding AskCommand}" Margin="8,0,0,0"/>
            <TextBox Text="{Binding Question, UpdateSourceTrigger=PropertyChanged}"/>
          </DockPanel>
        </Border>
        <Border Grid.Row="2" Style="{StaticResource Card}">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="{Binding AnswerBasis}" Style="{StaticResource Muted}" Margin="0,0,0,6"/>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <TextBlock Text="{Binding Answer}" Style="{StaticResource Muted}" TextWrapping="Wrap"/>
            </ScrollViewer>
          </DockPanel>
        </Border>
      </Grid>
    </Grid>
    <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" Style="{StaticResource Muted}" Margin="0,8,0,0"/>
  </Grid>
</UserControl>
