<UserControl x:Class="NOVA.FIX.App.Views.ScannerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:NOVA.FIX.App.Views">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Border Grid.Row="0" Style="{StaticResource Card}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button Style="{StaticResource PrimaryButton}" Content="Run Scan"
                  Command="{Binding ScanCommand}" Margin="0,0,8,0"/>
          <Button Style="{StaticResource GhostButton}" Content="Cancel"
                  Command="{Binding CancelCommand}"/>
        </StackPanel>
        <StackPanel>
          <TextBlock Text="{Binding Summary}" Style="{StaticResource H2}"/>
          <TextBlock Text="{Binding Progress}" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
          <ProgressBar Value="0" Height="4" Margin="0,8,0,0"
                       Visibility="{Binding IsScanning, Converter={x:Static views:UiConverters.BoolToVisibility}}"/>
        </StackPanel>
      </DockPanel>
    </Border>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="3*"/>
        <ColumnDefinition Width="2*"/>
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,12,6,0">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="Findings" Style="{StaticResource H2}" Margin="0,0,0,8"/>
          <ListBox ItemsSource="{Binding Findings}" BorderThickness="0" Background="Transparent">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="0,4">
                  <StackPanel Orientation="Horizontal">
                    <Border Style="{StaticResource Badge}">
                      <TextBlock Text="{Binding Severity}" FontSize="10"
                                 Foreground="{DynamicResource WarningBrush}"/>
                    </Border>
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Margin="8,0,0,0"/>
                  </StackPanel>
                  <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>
      <Border Grid.Column="1" Style="{StaticResource Card}" Margin="6,12,0,0">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="Probe log (failures reported independently)" Style="{StaticResource H2}" Margin="0,0,0,8"/>
          <ListBox ItemsSource="{Binding ProbeLog}" BorderThickness="0" Background="Transparent"
                   FontFamily="Consolas" FontSize="11"
                   Foreground="{DynamicResource TextSecondaryBrush}"/>
        </DockPanel>
      </Border>
    </Grid>
    <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" Style="{StaticResource Muted}" Margin="0,8,0,0"/>
  </Grid>
</UserControl>
