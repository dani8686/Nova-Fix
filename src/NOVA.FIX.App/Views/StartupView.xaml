<UserControl x:Class="NOVA.FIX.App.Views.StartupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Border Grid.Row="0" Style="{StaticResource Card}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button Style="{StaticResource PrimaryButton}" Content="Refresh" Command="{Binding RefreshCommand}" Margin="0,0,8,0"/>
          <Button Style="{StaticResource GhostButton}" Content="Export backup" Command="{Binding BackupCommand}" Margin="0,0,8,0"/>
          <Button Style="{StaticResource GhostButton}" Content="Disable selected"
                  Command="{Binding DisableCommand}"
                  Foreground="{DynamicResource DangerBrush}"/>
        </StackPanel>
        <StackPanel>
          <TextBlock Text="Startup entries (registration only — files are never deleted)" Style="{StaticResource H2}"/>
          <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
        </StackPanel>
      </DockPanel>
    </Border>
    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,12,0,0">
      <DataGrid ItemsSource="{Binding Entries}" SelectedItem="{Binding Selected}"
                AutoGenerateColumns="False" IsReadOnly="True"
                Background="Transparent" BorderThickness="0"
                HeadersVisibility="Column" RowBackground="Transparent"
                AlternatingRowBackground="{DynamicResource ElevatedBrush}">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="160"/>
          <DataGridTextColumn Header="Publisher" Binding="{Binding Publisher}" Width="140"/>
          <DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="140"/>
          <DataGridTextColumn Header="Signature" Binding="{Binding SignatureStatus}" Width="110"/>
          <DataGridTextColumn Header="Classification" Binding="{Binding Classification}" Width="110"/>
          <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="*"/>
        </DataGrid.Columns>
      </DataGrid>
    </Border>
  </Grid>
</UserControl>
