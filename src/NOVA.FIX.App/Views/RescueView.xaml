<UserControl x:Class="NOVA.FIX.App.Views.RescueView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <Border Grid.Row="0" Style="{StaticResource Card}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button Style="{StaticResource PrimaryButton}" Content="Refresh" Command="{Binding RefreshCommand}" Margin="0,0,8,0"/>
          <Button Style="{StaticResource GhostButton}" Content="Create restore point" Command="{Binding CreateRestorePointCommand}"/>
        </StackPanel>
        <StackPanel>
          <TextBlock Text="Rescue &amp; Restore" Style="{StaticResource H2}"/>
          <TextBlock Text="{Binding Disclaimer}" Style="{StaticResource Muted}" Margin="0,4,0,0"
                     Foreground="{DynamicResource WarningBrush}"/>
        </StackPanel>
      </DockPanel>
    </Border>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,12,6,0">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="Restore points" Style="{StaticResource H2}" Margin="0,0,0,8"/>
          <ListBox ItemsSource="{Binding RestorePoints}" BorderThickness="0" Background="Transparent">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="0,4">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                  <TextBlock Text="{Binding Created}" Style="{StaticResource Muted}"/>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>
      <Border Grid.Column="1" Style="{StaticResource Card}" Margin="6,12,6,0">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="Configuration snapshots" Style="{StaticResource H2}" Margin="0,0,0,8"/>
          <ListBox ItemsSource="{Binding Snapshots}" BorderThickness="0" Background="Transparent">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="0,4">
                  <TextBlock Text="{Binding Kind}" FontWeight="SemiBold"/>
                  <TextBlock Text="{Binding FilePath}" Style="{StaticResource Muted}" TextWrapping="Wrap"/>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>
      <Border Grid.Column="2" Style="{StaticResource Card}" Margin="6,12,0,0">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="Change journal" Style="{StaticResource H2}" Margin="0,0,0,8"/>
          <ListBox ItemsSource="{Binding Journal}" BorderThickness="0" Background="Transparent">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="0,4">
                  <TextBlock Text="{Binding Description}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                  <TextBlock Style="{StaticResource Muted}">
                    <Run Text="{Binding Module, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Target, Mode=OneWay}"/>
                  </TextBlock>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
