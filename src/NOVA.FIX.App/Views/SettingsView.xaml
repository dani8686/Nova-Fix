<UserControl x:Class="NOVA.FIX.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel MaxWidth="820" HorizontalAlignment="Left">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Settings -->
        <Border Grid.Column="0" Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="Settings" Style="{StaticResource H1}"/>
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
              <TextBlock Text="Theme" Width="120" VerticalAlignment="Center"/>
              <ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}" Width="120"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
              <TextBlock Text="Language" Width="120" VerticalAlignment="Center"/>
              <ComboBox ItemsSource="{Binding LanguageOptions}" SelectedItem="{Binding Language}" Width="120"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
              <TextBlock Text="Interval (s)" Width="120" VerticalAlignment="Center"/>
              <TextBox Width="80" Text="{Binding MonitoringInterval, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
              <TextBlock Text="History (days)" Width="120" VerticalAlignment="Center"/>
              <TextBox Width="80" Text="{Binding HistoryRetentionDays, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <CheckBox Content="Collect diagnostic history" IsChecked="{Binding CollectHistory}" Margin="0,10,0,0"/>
            <CheckBox Content="Show notifications" IsChecked="{Binding Notifications}" Margin="0,6,0,0"/>
            <CheckBox Content="Create restore point before repair"
                      IsChecked="{Binding RestorePointBeforeRepair}" Margin="0,6,0,0"/>
            <TextBlock Text="{Binding ReportDirectory}" Style="{StaticResource Muted}" Margin="0,12,0,0"
                       TextWrapping="Wrap"/>
            <WrapPanel Margin="0,10,0,0">
              <Button Style="{StaticResource PrimaryButton}" Content="Save settings"
                      Command="{Binding SaveCommand}" Margin="0,0,8,0"/>
              <Button Style="{StaticResource GhostButton}" Content="Open reports folder"
                      Command="{Binding OpenReportsCommand}"/>
            </WrapPanel>
            <TextBlock Text="{Binding VersionLine}" Style="{StaticResource Muted}" Margin="0,14,0,0"/>
          </StackPanel>
        </Border>

        <!-- About (mandatory creator attribution) -->
        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="12,0,0,0">
          <StackPanel>
            <TextBlock Text="{Binding AboutProduct}" FontSize="26" FontWeight="Bold"
                       Foreground="{DynamicResource AccentBrush}"/>
            <TextBlock Text="{Binding AboutTagline}" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
            <TextBlock Text="{Binding AboutCategory}" Style="{StaticResource Muted}" Margin="0,10,0,0"/>

            <Border Background="{DynamicResource ElevatedBrush}" CornerRadius="10"
                    Padding="14" Margin="0,16,0,0">
              <StackPanel>
                <TextBlock Text="{Binding AboutAttribution}" FontSize="15" FontWeight="SemiBold"
                           TextWrapping="Wrap"/>
                <Grid Margin="0,12,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>

                  <TextBlock Grid.Row="0" Grid.Column="0" Text="Instagram"
                             Foreground="{DynamicResource TextSecondaryBrush}"
                             VerticalAlignment="Center" Width="80"/>
                  <TextBox Grid.Row="0" Grid.Column="1" IsReadOnly="True"
                           Text="{Binding AboutInstagram, Mode=OneWay}"
                           Margin="8,0,8,0" FontFamily="Consolas"/>
                  <Button Grid.Row="0" Grid.Column="2" Style="{StaticResource GhostButton}"
                          Content="Copy"
                          Command="{Binding CopyInstagramCommand}"/>

                  <TextBlock Grid.Row="1" Grid.Column="0" Text="Email"
                             Foreground="{DynamicResource TextSecondaryBrush}"
                             VerticalAlignment="Center" Margin="0,8,0,0"/>
                  <TextBox Grid.Row="1" Grid.Column="1" IsReadOnly="True"
                           Text="{Binding AboutEmail, Mode=OneWay}"
                           Margin="8,8,8,0" FontFamily="Consolas"/>
                  <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource GhostButton}"
                          Content="Copy"
                          Command="{Binding CopyEmailCommand}"/>
                </Grid>
                <TextBlock Text="{Binding CopiedField}" Style="{StaticResource Muted}"
                           Margin="0,8,0,0"/>
              </StackPanel>
            </Border>

            <TextBlock Text="{Binding PrivacyNote}" Style="{StaticResource Muted}"
                       Margin="0,16,0,0"/>
          </StackPanel>
        </Border>
      </Grid>
      <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Muted}" Margin="0,8,0,0"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
