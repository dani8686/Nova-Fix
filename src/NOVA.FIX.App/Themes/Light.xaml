<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- NOVA FIX light theme — same design language, light surfaces -->
    <Color x:Key="BackgroundColor">#F4F7FB</Color>
    <Color x:Key="SidebarColor">#E8EDF4</Color>
    <Color x:Key="CardColor">#FFFFFF</Color>
    <Color x:Key="ElevatedColor">#EDF2F8</Color>
    <Color x:Key="AccentColor">#0EA5D6</Color>
    <Color x:Key="PurpleColor">#6757E8</Color>
    <Color x:Key="SuccessColor">#16A074</Color>
    <Color x:Key="WarningColor">#D89A22</Color>
    <Color x:Key="DangerColor">#DC4C64</Color>
    <Color x:Key="TextPrimaryColor">#0F172A</Color>
    <Color x:Key="TextSecondaryColor">#5B6B80</Color>

    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
    <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource SidebarColor}" />
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}" />
    <SolidColorBrush x:Key="ElevatedBrush" Color="{StaticResource ElevatedColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="PurpleBrush" Color="{StaticResource PurpleColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />

    <SolidColorBrush x:Key="HoverBrush" Color="#DDE6F0" />
    <SolidColorBrush x:Key="AccentSubtleBrush" Color="#D7F0FA" />
    <SolidColorBrush x:Key="BorderBrush" Color="#D3DCE8" />
    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#0EA5D6" Offset="0" />
        <GradientStop Color="#6757E8" Offset="1" />
    </LinearGradientBrush>

</ResourceDictionary>
