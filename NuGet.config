<?xml version="1.0" encoding="utf-8"?>
<!--
  NOVA FIX package sources.

  packages/offline is the local, offline-first feed used for reproducible
  offline builds (see OFFLINE_DEPENDENCIES.md and scripts/make-offline-feed.ps1).
  nuget.org is listed only for online preparation machines that assemble the
  offline feed; the product itself never performs network access at runtime.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="offline" value="packages/offline" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <config>
    <add key="globalPackagesFolder" value="packages/fallback" />
  </config>
</configuration>
